# Dependencies
node_modules/

# Builds & caches
dist/
build/
out/
.turbo/
*.tsbuildinfo
.next/
.vercel/
.cache/

# Test / coverage
coverage/
.nyc_output/

# Environment & secrets
# Real secrets go in `.env` / `.env.local` / `.env.*` (ignored).
# `.env.example` IS tracked on purpose as a placeholder template —
# never put real tokens/URLs with credentials in it.
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example

# Logs & debug
logs/
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# Misc
*.local
*.swp
*.swo
