{
  "name": "@savemytokens/types",
  "version": "0.0.0",
  "private": true,
  "description": "Universal TypeScript contracts for savemytokens triage results and RFC 7807 errors",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist *.tsbuildinfo",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "echo \"no tests yet\""
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": "24.x || 25.x"
  }
}
