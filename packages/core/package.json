{
  "name": "@savemytokens/core",
  "version": "0.0.0",
  "private": true,
  "description": "Pure pre-flight triage probe engine for savemytokens (SSRF, shields, llms.txt)",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist *.tsbuildinfo",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test src/**/*.test.ts"
  },
  "dependencies": {
    "@savemytokens/types": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": "24.x || 25.x"
  }
}
