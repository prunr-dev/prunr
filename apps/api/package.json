{
  "name": "@savemytokens/api",
  "version": "0.0.0",
  "private": true,
  "description": "savemytokens REST microservice — GET /v1/triage pre-flight triage",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/app.d.ts",
      "import": "./dist/app.js"
    }
  },
  "main": "./dist/app.js",
  "types": "./dist/app.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist *.tsbuildinfo",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "echo \"no tests yet\""
  },
  "dependencies": {
    "@hono/node-server": "^1.14.3",
    "@savemytokens/core": "workspace:*",
    "@savemytokens/types": "workspace:*",
    "@upstash/ratelimit": "^2.0.5",
    "@upstash/redis": "^1.35.0",
    "hono": "^4.7.10"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": "20.x"
  }
}
