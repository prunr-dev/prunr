# Local Node server port (ignored on Vercel)
PORT=8787

# Comma-separated browser origins allowed to call the API
# PLACEHOLDERS ONLY — real values belong in ignored `.env` / Vercel project env
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional Upstash Redis (rate limit + 60s triage cache). Leave empty here.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
