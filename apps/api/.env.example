# Local Node server port (ignored on Vercel)
PORT=8787

# Comma-separated browser origins allowed to call the API
# Defaults include localhost:3000 and https://prunr.dev when unset
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://prunr.dev

# Optional Upstash Redis (rate limit + 60s triage cache). Omit for local fail-open.
UPSTASH_REDIS_REST_URL="https://cute-buck-130784.upstash.io"
