{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "tsBuildInfoFile": null,
    "types": ["node"],
    "allowImportingTsExtensions": false
  },
  "include": ["./**/*.mts", "./**/*.ts"],
  "exclude": ["node_modules"]
}
